{
  "name": "yuanqi-warriors",
  "private": true,
  "version": "1.0.0",
  "description": "元气勇士 - 原创俯视角地牢射击 Roguelike（浏览器 / TypeScript + Canvas 2D）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "server": "node server/relay.mjs",
    "start": "npm run build && node server/relay.mjs",
    "smoke:relay": "node server/relay.smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build && npm run smoke:relay"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "ws": "^8.21.3"
  }
}
